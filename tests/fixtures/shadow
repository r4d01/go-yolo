#!/bin/sh
# Any privileged lookup of this executable is a regression. Unprivileged lookups delegate.
if [ "$(/usr/bin/id -u)" = 0 ]; then
  printf '%s\n' "$0" >>/home/goyolo-test/root-shadow
  exit 98
fi
shadow_name=${0##*/}
for shadow_dir in /usr/bin /usr/sbin /bin /sbin; do
  if [ -x "$shadow_dir/$shadow_name" ]; then exec "$shadow_dir/$shadow_name" "$@"; fi
done
exit 127
