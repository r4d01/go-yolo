#!/usr/bin/env bash
set -euo pipefail
{
  printf 'CALL\n'
  printf '%q\n' "$@"
} >>"$DOCKER_TEST_LOG"
# DOCKER_TEST_IMAGE_STATUS: 0 = every image exists, 1 = none does,
# built-on-build = only the images (-t tags) that a `docker build` has built.
if [[ $1 == build ]]; then
  args=("$@")
  for ((i = 0; i < ${#args[@]} - 1; i++)); do
    if [[ ${args[i]} == -t ]]; then printf '%s\n' "${args[i + 1]}" >>"$DOCKER_TEST_LOG.built"; fi
  done
fi
# The image list for --prune: $DOCKER_TEST_IMAGES holds tag, id, age, size, project, plan.
if [[ $* == image\ ls\ * ]]; then
  if [[ -n ${DOCKER_TEST_IMAGES:-} ]]; then cut -f1-4 "$DOCKER_TEST_IMAGES"; fi
  exit 0
fi
if [[ $* == image\ inspect\ --format\ *go-yolo.project* ]]; then
  for tag in "${@:4}"; do
    awk -F'\t' -v tag="$tag" '$1 == tag { print $5 "\t" $6 }' "$DOCKER_TEST_IMAGES"
  done
  exit 0
fi
if [[ $* == image\ inspect\ * ]]; then
  status=${DOCKER_TEST_IMAGE_STATUS:-0}
  if [[ $status == built-on-build ]]; then
    status=1
    if grep -qxF -- "${!#}" "$DOCKER_TEST_LOG.built" 2>/dev/null; then status=0; fi
  fi
  if ((status == 0)) && [[ $* == *'{{.Id}}'* ]]; then printf 'sha256:%s\n' "${DOCKER_TEST_IMAGE_ID:-0123abcd}"; fi
  exit "$status"
fi
# The base image's package list, read by `docker run --rm --entrypoint dpkg-query IMAGE ...`.
if [[ $* == run\ --rm\ --entrypoint\ dpkg-query\ * ]]; then
  if [[ -n ${DPKG_BASE_FIXTURE:-} ]]; then cat "$DPKG_BASE_FIXTURE"; fi
fi
# --parity's container run (`docker run ... IMAGE -c SCRIPT`): with DOCKER_TEST_RUN_SCRIPT=1 run
# the script here, edited by the sed script DOCKER_TEST_PARITY_SED (to fake a difference).
if [[ $1 == run && ${DOCKER_TEST_RUN_SCRIPT:-} == 1 && ${*: -2:1} == -c ]]; then
  bash -c "${!#}" | sed -e "${DOCKER_TEST_PARITY_SED:-}"
fi
